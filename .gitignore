# Build outputs and logs.
build/
*.out
*.log
*.profraw
stacks.txt
crash.txt

# Nothing from the game: your own copy goes in game-data/ (and the add-on in dlc-data/).
game-data/
dlc-data/
game-pkg/
dlc-pkg/
*.xex
*.xexp
# ReXGlue's C++ of the game's code (python tools/gen_manifest.py writes it).
generated/

